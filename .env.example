# --- Required ---
OPENROUTER_API_KEY=

# --- Optional (fail-soft; features degrade gracefully without them) ---
EXA_API_KEY=
ELEVENLABS_API_KEY=
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=agentic

# --- Server ---
PORT=4100
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5175

# --- Data ---
# Default data root is ~/.omni (omni.db, drive/, artifacts/, runs/)
# OMNI_DATA_DIR=

# --- Auth (single-user local) ---
AUTH_MODE=local
LOCAL_USER_ID=00000000-0000-4000-a000-000000000001
LOCAL_USER_EMAIL=local@omni.dev

# --- Tracing (off by default) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=omni
