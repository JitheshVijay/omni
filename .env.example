# --- Required ---
OPENROUTER_API_KEY=

# --- Optional (fail-soft; features degrade gracefully without them) ---
EXA_API_KEY=
ELEVENLABS_API_KEY=
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=agentic
# Composio: Gmail/Calendar Secretary via managed OAuth (no-op until set)
COMPOSIO_API_KEY=
# Apify: powers the linkedin_profile agent tool (scrape a public LinkedIn
# profile into real data for portfolios/bios). No-op until set. The default
# actor is overridable if you prefer a different one from the Apify store.
APIFY_API_KEY=
# APIFY_LINKEDIN_ACTOR=supreme_coder~linkedin-profile-scraper
# E2B: cloud sandboxes for the full-stack App Builder (run generated apps live
# with a public preview URL). Get a key at https://e2b.dev. No-op until set.
E2B_API_KEY=
# E2B_TEMPLATE=
# GitHub token (repo scope): deploy a generated app by pushing it to a repo in
# your account, then Omni gives you a one-click "Deploy to Render" link. Without
# it, Export .zip still works. No-op until set.
GITHUB_TOKEN=

# --- Server ---
PORT=4100
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5175

# --- Data ---
# Default data root is ~/.omni (omni.db, drive/, artifacts/, runs/)
# OMNI_DATA_DIR=

# --- Auth (single-user local) ---
AUTH_MODE=local
LOCAL_USER_ID=00000000-0000-4000-a000-000000000001
LOCAL_USER_EMAIL=local@omni.dev

# --- Tracing (off by default) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=omni
